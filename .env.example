# PostgreSQL
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

#  Backend
CORS_ORIGINS=

#  Frontend (Streamlit)
API_URL=http://localhost:8000

#  Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_in_production

# Database URL — local docker-compose default
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost/postgres_db

# Database URL — Neon (production, Frankfurt / eu-central-1)
# Récupérer depuis https://console.neon.tech > project "obrail" > Connection Details
# NEON_DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require
